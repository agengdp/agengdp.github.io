---
const clients = [
  { name: "Xcashshop", industry: "Gaming & Payment", logo: "/assets/logos/xcashshop.webp" },
  { name: "Eclectic Consulting", industry: "SAP Consulting", logo: "/assets/logos/eclectic.webp" },
  { name: "Brighty Indonesia", industry: "Beauty & Care", logo: "/assets/logos/brighty.png" },
  { name: "Nextsumo", industry: "SaaS & Automation", logo: "/assets/logos/nextsumo.png" },
  { name: "PT Karuna Teknologi Inti Indonesia", industry: "Web Hosting", logo: "/assets/logos/karuna.png" },
  { name: "Imerspedia", industry: "IT & Media", logo: "/assets/logos/imerspedia.png" },
  { name: "Iklan Properti", industry: "Real Estate Listing", logo: "/assets/logos/iklan-properti.png" },
  { name: "PPOB Service", industry: "PPOB", logo: "/assets/logos/ppob-logo.jpg" },
  { name: "Smartwise Pro", industry: "Consulting & Training", logo: "/assets/logos/smartwise.jpg" },
];

const doubledClients = [...clients, ...clients];
---

<div class="relative overflow-hidden bg-background py-6 border-y border-border/50">


  <div class="group relative flex overflow-hidden select-none">
    <div class="flex min-w-full shrink-0 items-center justify-start gap-4 animate-marquee px-4">
      {doubledClients.map((client) => (
        <div class="flex flex-col items-center justify-center min-w-[120px] grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all duration-500 cursor-pointer">
           <div class="h-12 w-full flex items-center justify-center px-4">
             <img 
               src={client.logo} 
               alt={`${client.name} logo`} 
               class="max-h-full max-w-full object-contain"
             />
           </div>
           <span class="mt-2 text-[8px] font-medium uppercase tracking-[0.2em] text-muted-foreground/30 group-hover:text-muted-foreground/50 transition-colors">
             {client.industry}
           </span>
        </div>
      ))}
    </div>
    
    <!-- Duplicate for seamless scroll -->
    <div aria-hidden="true" class="flex min-w-full shrink-0 items-center justify-start gap-4 animate-marquee px-4">
      {doubledClients.map((client) => (
        <div class="flex flex-col items-center justify-center min-w-[120px] grayscale opacity-40 hover:grayscale-0 hover:opacity-100 transition-all duration-500 cursor-pointer">
           <div class="h-12 w-full flex items-center justify-center px-4">
             <img 
               src={client.logo} 
               alt={`${client.name} logo`} 
               class="max-h-full max-w-full object-contain"
             />
           </div>
           <span class="mt-2 text-[8px] font-medium uppercase tracking-[0.2em] text-muted-foreground/30 group-hover:text-muted-foreground/50 transition-colors">
             {client.industry}
           </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Fade gradients for edge smoothing -->
  <div class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-background to-transparent"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-background to-transparent"></div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-100%); }
  }
  .animate-marquee {
    animation: marquee 40s linear infinite;
  }
  .group:hover .animate-marquee {
    animation-play-state: paused;
  }
</style>
