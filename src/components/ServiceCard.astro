---
import { ArrowUpRight } from "lucide-react";
import { Badge } from "./ui/badge";

interface Props {
  title: string;
  description: string;
  href: string;
  tags: string[];
  icon: any;
}

const { title, description, href, tags, icon: Icon } = Astro.props;
---

<a 
  href={href} 
  class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-muted/60 bg-card/50 p-7 transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-card hover:shadow-2xl hover:shadow-primary/5"
>
  <div class="relative z-10">
    <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-muted/50 p-0.5 outline outline-1 outline-transparent transition-all group-hover:bg-primary/10 group-hover:text-primary group-hover:outline-primary/20">
        <div class="flex h-full w-full items-center justify-center rounded-[14px] bg-background">
            <Icon size={28} strokeWidth={1.5} />
        </div>
    </div>
    <h3 class="text-xl font-bold tracking-tight">{title}</h3>
    <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground/90">
      {description}
    </p>
    <div class="mt-6 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="rounded-full bg-muted/80 px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground transition-colors group-hover:bg-primary/5 group-hover:text-primary/80">
          {tag}
        </span>
      ))}
    </div>
  </div>

  <div class="mt-8 flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-widest text-muted-foreground/60 transition-colors group-hover:text-primary">Explore Service</span>
    <div class="rounded-full bg-muted/50 p-2 transition-all group-hover:bg-primary group-hover:text-primary-foreground">
        <ArrowUpRight size={18} strokeWidth={2.5} />
    </div>
  </div>

  <!-- Decorative background elements -->
  <div class="absolute -right-12 -top-12 -z-0 h-40 w-40 rounded-full bg-primary/5 blur-3xl transition-opacity group-hover:opacity-100 opacity-0"></div>
  <div class="absolute -bottom-8 -left-8 -z-0 h-32 w-32 rounded-full bg-primary/5 blur-3xl transition-opacity group-hover:opacity-100 opacity-0"></div>
</a>
