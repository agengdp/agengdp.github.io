---
import PageLayout from "./PageLayout.astro";
import { Badge } from "../components/ui/badge";
import { ArrowLeft, CheckCircle2 } from "lucide-react";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  tags: string[];
  deliverables: string[];
  process: { title: string; description: string }[];
  active?: string;
}

const { title, description, tags, deliverables, process, active = "services" } = Astro.props;
---

<PageLayout title={title} active={active}>
  <main class="mx-auto w-full max-w-4xl px-6 py-10 md:py-20">
    <!-- Back Navigation -->
    <a 
      href="/services" 
      class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors mb-10 group"
    >
      <ArrowLeft size={16} className="transition-transform group-hover:-translate-x-1" />
      Back to Services
    </a>

    <div class="space-y-16">
      <!-- Hero Section -->
      <section class="space-y-6">
        <div class="space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border bg-muted/50 text-[10px] font-bold uppercase tracking-widest text-primary">
            Service Details
          </div>
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">
            {title}
          </h1>
          <p class="text-lg md:text-xl text-muted-foreground leading-relaxed">
            {description}
          </p>
        </div>

        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <Badge variant="secondary" className="px-3 py-1 font-medium bg-muted/50 border-border/50">
              {tag}
            </Badge>
          ))}
        </div>
      </section>

      <!-- What you get Section -->
      <section class="space-y-8">
        <div class="space-y-2">
          <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Key Deliverables</h2>
          <p class="text-2xl font-semibold tracking-tight">Structured for quality and performance.</p>
        </div>
        
        <div class="grid gap-4 sm:grid-cols-2">
          {deliverables.map((item) => (
            <div class="flex items-start gap-3 rounded-xl border bg-card/40 p-5 transition-all hover:border-primary/20 hover:bg-card">
              <div class="flex h-6 w-6 mt-0.5 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <CheckCircle2 size={14} />
              </div>
              <span class="text-sm font-medium text-muted-foreground leading-tight">{item}</span>
            </div>
          ))}
        </div>
      </section>

      <!-- Process Section -->
      <section class="space-y-10">
         <div class="space-y-2">
          <h2 class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">The Process</h2>
          <p class="text-2xl font-semibold tracking-tight">How we'll bring your vision to life.</p>
        </div>

        <div class="relative space-y-8 before:absolute before:left-[17px] before:top-2 before:h-[calc(100%-16px)] before:w-px before:bg-border">
          {process.map((step, index) => (
            <div class="relative pl-12">
              <div class="absolute left-0 top-0 flex h-9 w-9 items-center justify-center rounded-full border bg-background font-mono text-xs font-bold text-muted-foreground ring-8 ring-background">
                {String(index + 1).padStart(2, '0')}
              </div>
              <div class="space-y-1">
                <h3 class="font-semibold tracking-tight">{step.title}</h3>
                <p class="text-sm text-muted-foreground leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA / Next Steps -->
      <section class="rounded-3xl border bg-card p-8 md:p-12 text-center space-y-6 relative overflow-hidden">
        <div class="absolute inset-0 bg-primary/[0.02] -z-10"></div>
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full bg-primary/5 blur-3xl"></div>
        
        <h2 class="text-2xl font-bold tracking-tight">Ready to get started?</h2>
        <p class="text-muted-foreground max-w-md mx-auto">
          Let's discuss your project and see how I can help you achieve your goals.
        </p>
        <div class="pt-4">
          <a 
            href="/contact" 
            class="inline-flex h-12 items-center justify-center rounded-full bg-primary px-8 text-sm font-semibold text-primary-foreground transition-all hover:scale-105 active:scale-95 shadow-lg shadow-primary/20"
          >
            Start a Project
          </a>
        </div>
      </section>
    </div>
  </main>
</PageLayout>

