---
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/global.css";
import { Badge } from "../components/ui/badge";
import { Button } from "../components/ui/button";

const projects = [
  {
    title: "PayFlow",
    subtitle: "Payment Gateway Engine",
    description: "A high-performance payment gateway supporting Virtual Accounts, QRIS, and E-Money integrations. Built with a microservices architecture for high scalability and secure transaction processing.",
    image: "/assets/projects/payment-gateway.png",
    tags: ["Go", "Laravel", "VueJS", "RabbitMQ", "K8s"],
    link: "/projects/payflow",
    featured: true
  },
  {
    title: "MedKiosk",
    subtitle: "Hospital Self-Registration",
    description: "Self-service kiosks for hospital patient registration, reducing wait times by 40%. Integrated with on-premise Kubernetes and NATS for robust, event-driven messaging.",
    image: "/assets/projects/hospital-kiosk.png",
    tags: ["VueJS", "Raspberry Pi", "NATS", "Go", "K8s"],
    link: "/projects/medkiosk",
    featured: true
  },
  {
    title: "LogiWare",
    subtitle: "Warehouse Management System",
    description: "An end-to-end warehouse solution for real-time inventory tracking, order management, and shipping automation. Focused on operational efficiency and data accuracy.",
    image: "/assets/projects/warehouse-system.png",
    tags: ["CodeIgniter 3", "MySQL", "Bulma UI", "PHP"],
    link: "/projects/logiware",
    featured: false
  },
  {
    title: "CloudScale API",
    subtitle: "Microservices Infrastructure",
    description: "Automated API scaling and management layer designed for high-traffic environments, ensuring 99.9% uptime with Kubernetes auto-replication and Redis caching.",
    image: "/assets/projects/cloudscale-infra.png",
    tags: ["Go", "Docker", "Kubernetes", "Redis"],
    link: "/projects/cloudscale",
    featured: false
  }
];
---

<PageLayout title="Projects · Ageng D. Prastyawan" active="projects">
  <main class="mx-auto w-full max-w-4xl px-6 py-10 md:py-20">
    <div class="space-y-4">
        <h1 class="text-3xl font-bold tracking-tight md:text-4xl">Selected Work</h1>
        <p class="max-w-xl text-muted-foreground">
        A collection of projects I've built, ranging from high-performance payment engines to specialized industrial hardware integrations.
        </p>
    </div>

    <div class="mt-12">
      <!-- Bento Grid -->
      <section class="grid grid-cols-1 gap-5 md:grid-cols-3 md:auto-rows-[220px]">
        {projects.map((p, idx) => {
          // Bento spans: first project big (2x2), second tall (1x2), rest wide (2x1) or normal (1x1)
          const spanClass = idx === 0
            ? "md:col-span-2 md:row-span-2"
            : idx === 1
            ? "md:col-span-1 md:row-span-2"
            : idx === 2
            ? "md:col-span-2 md:row-span-1"
            : "md:col-span-1 md:row-span-1";
          return (
            <a href={p.link} class={`group relative overflow-hidden rounded-2xl border bg-muted shadow-sm transition-all duration-300 hover:shadow-xl hover:border-primary/20 ${spanClass}`}>
              <img
                src={p.image}
                alt={p.title}
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent" />

              {p.featured && (
                <Badge variant="outline" className="absolute right-3 top-3 border-white/30 bg-black/30 font-mono text-[9px] uppercase tracking-wider text-white backdrop-blur-sm">Featured</Badge>
              )}

              <div class="absolute inset-x-0 bottom-0 p-4 md:p-5">
                <h3 class="text-lg font-semibold tracking-tight text-white md:text-xl">{p.title}</h3>
                <p class="mt-0.5 text-xs font-medium text-white/70 md:text-sm">{p.subtitle}</p>
                <div class="mt-2.5 flex flex-wrap gap-1.5">
                  {p.tags.slice(0, idx === 0 ? 5 : 3).map((t) => (
                    <Badge variant="secondary" className="border-0 bg-white/15 px-1.5 py-0 text-[9px] text-white backdrop-blur-sm">{t}</Badge>
                  ))}
                </div>
              </div>
            </a>
          );
        })}
      </section>
    </div>

    <!-- CTA -->
    <section class="mt-24 rounded-3xl border bg-card p-8 text-center md:p-12 relative overflow-hidden">
        <div class="absolute right-0 top-0 -mr-16 -mt-16 h-64 w-64 rounded-full bg-primary/5 blur-3xl"></div>
        <div class="relative">
            <h2 class="text-2xl font-bold tracking-tight">Have a project in mind?</h2>
            <p class="mt-4 text-muted-foreground">I'm always looking for interesting projects and collaborations.</p>
            <div class="mt-8 flex justify-center gap-4">
                <Button asChild size="lg">
                    <a href="/contact">Get in Touch</a>
                </Button>
                <Button asChild variant="outline" size="lg">
                    <a href="/services">Our Services</a>
                </Button>
            </div>
        </div>
    </section>
  </main>
</PageLayout>
