---
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/global.css";
import { Button } from "../components/ui/button";
import { Input } from "../components/ui/input";
import { Textarea } from "../components/ui/textarea";
import { Separator } from "../components/ui/separator";
import { Mail, MessageSquare, Phone, Github, Twitter, Linkedin, Send, ArrowRight } from "lucide-react";

const email = "rexcarnation@gmail.com";
const phone = "0895-6331-56874";
const whatsapp = "https://wa.me/62895633156874";
const github = "https://github.com/agengdp";
const twitter = "https://x.com/agengdp";
const linkedin = "https://linkedin.com/in/agengdp";

const socialLinks = [
  { icon: Github, href: github, label: "GitHub" },
  { icon: Twitter, href: twitter, label: "Twitter" },
  { icon: Linkedin, href: linkedin, label: "LinkedIn" },
];
---

<PageLayout title="Contact" active="contact">
  <main class="mx-auto w-full max-w-4xl px-6 py-10 md:py-16">
    <div class="space-y-12">
      <!-- Header -->
      <section class="space-y-4">
        <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
        <p class="text-muted-foreground leading-relaxed">
          I'm currently available for freelance work and new opportunities. If you have a project in mind or just want to say hi, feel free to reach out.
        </p>
      </section>

      <Separator />

      <!-- Contact Form -->
      <section class="space-y-6">
        <h2 class="text-sm font-medium uppercase tracking-widest text-muted-foreground/60">Send a message</h2>
        <form class="space-y-4">
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="space-y-2">
              <label for="name" class="text-xs font-medium text-muted-foreground ml-1">Name</label>
              <Input id="name" placeholder="Your name" required className="bg-card/50" />
            </div>
            <div class="space-y-2">
              <label for="email" class="text-xs font-medium text-muted-foreground ml-1">Email</label>
              <Input id="email" type="email" placeholder="you@example.com" required className="bg-card/50" />
            </div>
          </div>
          <div class="space-y-2">
            <label for="message" class="text-xs font-medium text-muted-foreground ml-1">Message</label>
            <Textarea 
              id="message" 
              placeholder="Tell me about your project..." 
              required 
              className="min-h-[150px] bg-card/50 resize-none" 
            />
          </div>
          <Button type="submit" className="w-full sm:w-auto h-11 px-8 gap-2 group">
            Send Message
            <Send size={16} className="transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
          </Button>
        </form>
      </section>

      <Separator />

      <!-- Direct Contact & Socials -->
      <div class="grid gap-12 sm:grid-cols-2">
        <!-- Direct -->
        <section class="space-y-6">
          <h2 class="text-sm font-medium uppercase tracking-widest text-muted-foreground/60">Connect</h2>
          <div class="space-y-4">
             <a href={`mailto:${email}`} class="group flex items-center justify-between rounded-lg border bg-card p-4 transition-all hover:bg-accent hover:border-primary/20">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-muted text-muted-foreground group-hover:bg-primary/10 group-hover:text-primary transition-colors">
                  <Mail size={18} />
                </div>
                <div>
                  <p class="text-xs font-medium text-muted-foreground">Email</p>
                  <p class="text-sm font-medium">{email}</p>
                </div>
              </div>
              <ArrowRight size={16} className="text-muted-foreground opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" />
            </a>

            <a href={whatsapp} target="_blank" rel="noreferrer" class="group flex items-center justify-between rounded-lg border bg-card p-4 transition-all hover:bg-accent hover:border-primary/20">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-muted text-muted-foreground group-hover:bg-primary/10 group-hover:text-primary transition-colors">
                  <MessageSquare size={18} />
                </div>
                <div>
                  <p class="text-xs font-medium text-muted-foreground">WhatsApp</p>
                  <p class="text-sm font-medium">+62 895 6331 56874</p>
                </div>
              </div>
              <ArrowRight size={16} className="text-muted-foreground opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" />
            </a>

            <a href={`tel:${phone}`} class="group flex items-center justify-between rounded-lg border bg-card p-4 transition-all hover:bg-accent hover:border-primary/20">
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-md bg-muted text-muted-foreground group-hover:bg-primary/10 group-hover:text-primary transition-colors">
                  <Phone size={18} />
                </div>
                <div>
                  <p class="text-xs font-medium text-muted-foreground">Phone</p>
                  <p class="text-sm font-medium">{phone}</p>
                </div>
              </div>
              <ArrowRight size={16} className="text-muted-foreground opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0" />
            </a>
          </div>
        </section>

        <!-- Socials -->
        <section class="space-y-6">
          <h2 class="text-sm font-medium uppercase tracking-widest text-muted-foreground/60">Social Profiles</h2>
          <div class="grid grid-cols-3 gap-3">
            {socialLinks.map((social) => (
              <a 
                href={social.href}
                target="_blank"
                rel="noreferrer"
                class="flex flex-col items-center justify-center aspect-square rounded-lg border bg-card transition-all hover:bg-accent hover:border-primary/20 hover:scale-[1.02] group"
                aria-label={social.label}
              >
                <social.icon size={22} className="text-muted-foreground group-hover:text-primary transition-colors" />
                <span class="mt-2 text-[10px] font-medium uppercase tracking-wider text-muted-foreground group-hover:text-foreground">{social.label}</span>
              </a>
            ))}
          </div>
          <div class="rounded-lg border bg-card p-4">
             <p class="text-xs leading-relaxed text-muted-foreground">
               I typically respond to messages within 24 hours. For urgent matters, reaching out via WhatsApp is the fastest way to get a reply.
             </p>
          </div>
        </section>
      </div>
    </div>
  </main>
</PageLayout>

