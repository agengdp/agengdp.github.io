---
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/global.css";

import { Badge } from "../components/ui/badge";
import { Button } from "../components/ui/button";
import { Card, CardContent, CardHeader, CardTitle } from "../components/ui/card";
import { Separator } from "../components/ui/separator";

import AvailabilityCard from "../components/AvailabilityCard.astro";
import StatCard from "../components/StatCard.astro";
import ServiceCard from "../components/ServiceCard.astro";
import ClientCloud from "../components/ClientCloud.astro";
import { Layout, Code2, Globe } from "lucide-react";

const NAME = "Ageng D. Prastyawan";
const ROLE = "Full Stack Developer";

const headline = "Full-Stack\nDeveloper &\nWeb Architect";
const intro =
  "Hi, I'm Ageng D. Prastyawan. Self-taught programmer with 10+ years experience in IT. I specialize in building robust applications using PHP, Golang, JavaScript, and TypeScript, delivering end-to-end solutions with a focus on performance and scalability.";

const socials = [
  { label: "GitHub", href: "https://github.com/agengdp" },
  { label: "LinkedIn", href: "https://linkedin.com/in/agengdp" },
  { label: "X", href: "https://x.com/agengdp" },
  { label: "Email", href: "mailto:rexcarnation@gmail.com" },
  { label: "WhatsApp", href: "https://wa.me/62895633156874" },
];

const stats = [
  { label: "Experience", value: "10+ Years" },
  { label: "Projects", value: "30+ Delivered" },
];

const services = [
  {
    title: "WordPress Development",
    description: "Custom themes, high-performance plugins, and enterprise-grade security.",
    href: "/services/wordpress-development",
    icon: Globe,
    tags: ["PHP", "Custom UI", "SEO"]
  },
  {
    title: "NextJS Development",
    description: "Modern full-stack applications with React, TypeScript, and edge runtime.",
    href: "/services/nextjs-development",
    icon: Layout,
    tags: ["React", "SSR", "Vercel"]
  },
  {
    title: "Full Stack Development",
    description: "End-to-end delivery from robust backend systems to scalable infrastructure.",
    href: "/services/full-stack-development",
    icon: Code2,
    tags: ["Go", "Node.js", "K8s"]
  },
];

const posts = [
  { title: "The Future of Web Development in 2026", date: "2026-03-15", href: "/blog/first-post" },
  { title: "Mastering Tailwind CSS v4: The Engine Rewrite", date: "2026-02-28", href: "/blog/mastering-tailwind-v4" },
  { title: "Building High-Performance APIs with Go and Fiber", date: "2026-02-12", href: "/blog/building-high-performance-apis-with-go-fiber" },
];
---

<PageLayout title={`${NAME} · ${ROLE}`} description={`${ROLE} · ${NAME}`} active="portfolio">
  <main class="mx-auto w-full max-w-4xl px-6 py-10 md:py-20">
    <!-- Hero like madebyaris.com -->
    <section class="grid gap-8 md:grid-cols-12 md:items-start">
      <div class="md:col-span-7">
        <div class="inline-flex items-center gap-2 rounded-full border bg-card px-3 py-1 text-sm text-muted-foreground">
          <span class="inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
          Available to Hire
        </div>

        <div class="mt-6">
          <h1 class="whitespace-pre-line text-4xl font-semibold tracking-tight md:text-5xl">
            {headline}
          </h1>
          <p class="mt-4 max-w-xl text-muted-foreground">{intro}</p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <div class="flex flex-wrap gap-2">
            {socials.map((s) => (
              <a 
                href={s.href} 
                target="_blank" 
                rel="noreferrer"
                class="inline-flex h-8 items-center justify-center rounded-md border border-input bg-background px-3 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
              >
                {s.label}
              </a>
            ))}
          </div>
          <a 
            href="/services" 
            class="inline-flex h-8 items-center justify-center rounded-md bg-foreground px-4 text-sm font-medium text-background transition-colors hover:opacity-90"
          >
            View Services
          </a>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="grid gap-4">
          <AvailabilityCard />
          <div class="grid gap-4 sm:grid-cols-3 md:grid-cols-1">
            {stats.map((s) => (
              <StatCard label={s.label} value={s.value} />
            ))}
          </div>
          <div class="group relative overflow-hidden rounded-2xl border bg-card p-5 transition-all hover:border-primary/20">
            <div class="relative z-10">
              <div class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground/70">Specialization</div>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {["PHP", "Laravel", "Golang", "TypeScript", "React", "Next.js", "WordPress", "Docker", "Kubernetes"].map(tech => (
                  <Badge variant="secondary" className="px-2 py-0 text-[10px] font-normal bg-muted/50 hover:bg-primary/10 hover:text-primary transition-colors">
                    {tech}
                  </Badge>
                ))}
              </div>
            </div>
            <div class="absolute -bottom-6 -left-6 h-20 w-20 rounded-full bg-primary/5 blur-2xl transition-opacity group-hover:opacity-100 opacity-0"></div>
          </div>
        </div>
      </div>
    </section>

    <div class="pt-3">
      <ClientCloud />
    </div>

    <div class="py-6">
      <!-- Services preview -->
      <section class="space-y-4">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-xl font-semibold tracking-tight">Expert Development Services</h2>
        <a class="text-sm text-muted-foreground underline" href="/services">View all services</a>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {services.map((s) => (
          <ServiceCard {...s} />
        ))}
      </div>

      <div class="text-sm text-muted-foreground">
        10+ years of experience building scalable solutions. Remote-first workflow with clear communication.
      </div>
      </section>
    </div>

    <Separator className="my-10" />

    <div class="py-6">
      <!-- Latest insights -->
    <section class="space-y-4">
      <div class="flex items-end justify-between gap-4">
        <h2 class="text-xl font-semibold tracking-tight">Latest Insights</h2>
        <a class="text-sm text-muted-foreground underline" href="/blog">View all posts</a>
      </div>

      <div class="grid gap-3">
        {posts.map((post) => (
          <a class="group relative flex items-center justify-between gap-4 overflow-hidden rounded-xl border bg-card/50 p-4 transition-all hover:border-primary/30 hover:bg-card hover:shadow-lg hover:shadow-primary/5" href={post.href}>
            <div class="flex items-center gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted text-muted-foreground transition-colors group-hover:bg-primary/10 group-hover:text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </div>
                <span class="font-medium tracking-tight group-hover:text-primary transition-colors">{post.title}</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs font-medium text-muted-foreground tabular-nums">{post.date}</span>
                <div class="rounded-full p-1 opacity-0 transition-all group-hover:bg-primary/10 group-hover:text-primary group-hover:opacity-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
                </div>
            </div>
          </a>
        ))}
      </div>
      </section>
    </div>

    <footer class="mt-14 text-sm text-muted-foreground">
      Built with Astro + Tailwind + shadcn/ui.
    </footer>
  </main>
</PageLayout>
